From db9417be683a926df57f640919ee4663c790c85e Mon Sep 17 00:00:00 2001
From: rsnrk <robert@nasarek.dev>
Date: Tue, 29 Sep 2026 18:17:02 +0200
Subject: [PATCH] fix: keep the Django repository when RDF4J PUT is not 204

RDF4J 6 answers 204; other versions answer 201. A second PUT is 400/409/412.
Raising on those deleted the Django row, so SPARQL via authproxy 404'd while the store still existed.
---
 authproxy/rdf4j/models.py | 20 +++++++++++++++-----
 1 file changed, 15 insertions(+), 5 deletions(-)

diff --git a/authproxy/rdf4j/models.py b/authproxy/rdf4j/models.py
index d835233..a155e9c 100644
--- a/authproxy/rdf4j/models.py
+++ b/authproxy/rdf4j/models.py
@@ -512,11 +512,21 @@ Available variables:
             url=url, data=self.to_turtle(), headers=headers, timeout=REQUEST_TIMEOUT
         )
 
-        # TODO: Better error handling here... See if there are different codes
-        # and messages that are returned by rdf4j and handle them accordingly
-        if response.status_code != 204:
-            raise IntegrityError(f"The {self.slug} repository already has a remote!")
-        self.has_remote = True
+        # RDF4J 6 returns 204 for a new store; some versions use 201. A second
+        # PUT for the same id is refused (400/409/412) — treat as already there
+        # so the Django row is kept. Only 204 used to be accepted; anything else
+        # raised, the post_save handler deleted the row, and SPARQL via
+        # authproxy 404'd while RDF4J still had the store.
+        if response.status_code in (200, 201, 204):
+            self.has_remote = True
+            return
+        if response.status_code in (400, 409, 412):
+            self.has_remote = True
+            return
+        raise IntegrityError(
+            f"RDF4J did not create repository {self.slug!r} "
+            f"(HTTP {response.status_code}): {(response.text or '')[:300]}"
+        )
 
     def delete_remote(self) -> None:
         """Delete the corresponding repository from from the RDF4J server"""
