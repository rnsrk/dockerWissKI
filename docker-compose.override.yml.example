# Machine-local Compose overlay. Copy to docker-compose.override.yml (gitignored)
# and append :docker-compose.override.yml to COMPOSE_FILE in .env.
#
# Last file in COMPOSE_FILE wins. Keep this document valid Compose YAML.
#
# Default below persists remote Cursor/VS Code/Claude Code server state in named
# volumes and mounts the shared WissKI workspace `.vscode/` from this repo.
# Uncomment personal mounts from gitignored `.container-dev/` (Machine
# settings, Cursor/Claude rules/skills/agents). Optional WissKI host bind and SSH key
# mounts are commented.
#
# Attach as user `developer` (host UID, default 1000). PID 1 stays root for
# nginx/php-fpm. Set DEV_UID/DEV_GID in .env if your host user is not 1000.
#
# Optional host path for live WissKI module editing (uncomment the mount below):
#   WISSKI_HOST_PATH=/absolute/or/relative/path/to/wisski/clone
#
# Optional host SSH keys for git@ remotes from the attached IDE (uncomment
# the mount below). Direct bind onto /home/developer/.ssh — OpenSSH accepts
# it because developer matches the host UID. Prefer a dedicated key dir if
# you do not want the full host agent config inside the container:
#   SSH_HOST_PATH=/home/you/.ssh
#   SSH_HOST_PATH=./.container-dev/ssh
#
# Personal container-only IDE config (gitignored except wisski-vscode/):
#   CONTAINER_DEV_PATH=./.container-dev
# Put Machine settings, Cursor/Claude rules/skills, and a local WissKI clone there.
# Claude Code rules/skills bind onto `/home/developer/.claude/` (same pattern as
# Cursor) so the WissKI clone stays without a `.claude/` directory.

services:
  drupal:
    volumes:
      # --- Persist remote IDE server + agent state (recommended) ---
      - cursor-server:/home/developer/.cursor-server
      - vscode-server:/home/developer/.vscode-server
      - cursor-directory:/home/developer/.cursor
      - claude-directory:/home/developer/.claude

      # --- Optional: personal container-only IDE config (untracked) ---
      # Uncomment the files/dirs you want from your personal gitignored folder.
      # Cursor and VS Code share the same settings schema but keep separate
      # remote-server dirs; mount one host file to both destinations:
      # - ${CONTAINER_DEV_PATH:-./.container-dev}/vscode-machine-settings.json:/home/developer/.cursor-server/data/Machine/settings.json:ro
      # - ${CONTAINER_DEV_PATH:-./.container-dev}/vscode-machine-settings.json:/home/developer/.vscode-server/data/Machine/settings.json:ro
      #
      # Optional Cursor rules / skills / agents that apply only inside the attached container:
      # - ${CONTAINER_DEV_PATH:-./.container-dev}/cursor/rules:/home/developer/.cursor/rules:ro
      # - ${CONTAINER_DEV_PATH:-./.container-dev}/cursor/skills:/home/developer/.cursor/skills:ro
      # - ${CONTAINER_DEV_PATH:-./.container-dev}/cursor/agents:/home/developer/.cursor/agents:ro
      #
      # Optional Claude Code rules / skills / agents / settings.json (convert
      # rules with roBot_rules/scripts/install.sh). Bind onto the developer
      # home dir — do not mount into the WissKI clone:
      # - ${CONTAINER_DEV_PATH:-./.container-dev}/claude/rules:/home/developer/.claude/rules:ro
      # - ${CONTAINER_DEV_PATH:-./.container-dev}/claude/skills:/home/developer/.claude/skills:ro
      # - ${CONTAINER_DEV_PATH:-./.container-dev}/claude/agents:/home/developer/.claude/agents:ro
      # - ${CONTAINER_DEV_PATH:-./.container-dev}/claude/settings.json:/home/developer/.claude/settings.json:ro

      # --- Optional: host SSH keys for git@ remotes ---
      # Development image includes openssh-client. Attach as `developer` so a
      # direct bind works (no key copying). Uncomment one:
      # - ~/.ssh:/home/developer/.ssh
      # - ${SSH_HOST_PATH}:/home/developer/.ssh
      # - ${CONTAINER_DEV_PATH:-./.container-dev}/ssh:/home/developer/.ssh

      # Shared WissKI workspace VS Code/Cursor config (in this repo).
      - ./.container-dev/wisski-vscode:/opt/drupal/web/modules/contrib/wisski/.vscode:ro

      # --- Optional: host WissKI clone instead of the wisski-module volume ---
      # Same target path, so this replaces the named volume from
      # docker-compose.development.yml. An empty host dir is cloned at boot.
      # ONE module only: do NOT mount all of web/modules/contrib or vendor.
      # - ${WISSKI_HOST_PATH:-../wisski}:/opt/drupal/web/modules/contrib/wisski

      # --- Optional: custom site code ---
      # - ./path/to/module:/opt/drupal/web/modules/custom/my-module
      # - ./path/to/theme:/opt/drupal/web/themes/custom/my-theme

    # Optional: expose Postgres on localhost for host GUI tools
    # (pgAdmin is already available via profile tools)

  # postgres:
  #   ports:
  #     - "127.0.0.1:5432:5432"

volumes:
  cursor-server:
  vscode-server:
  cursor-directory:
  claude-directory:
