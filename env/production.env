# Production preset: Prod image, Varnish as HTTP entry.
#   cp env/production.env .env && docker compose up -d
#
# Set all passwords and emails in .env before the first start.
#
# Requires COMPOSE_PROFILES to include "production" so Varnish starts.

COMPOSE_PROJECT_NAME=dockerwisski
COMPOSE_FILE=docker-compose.yml:docker-compose.production.yml
# Optional overlays (append to COMPOSE_FILE):
#   docker-compose.local-build.yml     # build the Drupal image locally
#   docker-compose.apple-silicon.yml   # amd64 via Rosetta
#   docker-compose.override.yml        # machine-local; gitignored, see *.example
COMPOSE_PROFILES=production,tools
# Add solr when Search API needs it: COMPOSE_PROFILES=production,tools,solr

MODE=production
WISSKI_IMAGE_VERSION=latest
WISSKI_PACKAGES_VERSION=3.7.0
WISSKI_PACKAGES_LINE=3.x

# Public HTTP (Varnish in this preset)
HTTP_PORT=80
DRUPAL_DIRECT_PORT=8082

# Drupal / WissKI
DRUPAL_DOMAIN=localhost
DRUPAL_LOCALE=en
DRUPAL_USER=admin
DRUPAL_PASSWORD=
DRUPAL_SITE_NAME=My WissKI
DRUPAL_TRUSTED_HOSTS='^localhost$|^127\.0\.0\.1$'
DRUPAL_PRIVATE_FILES_DIR=/opt/drupal/private-files
DRUPAL_PROXY_ADDRESSES=auto
WISSKI_STARTER_VERSION=true
WISSKI_DEFAULT_DATA_MODEL_VERSION=true
WISSKI_DEFAULT_GRAPH=https://my.wiss-ki.eu/

# PostgreSQL
DB_DRIVER=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wisski
DB_USER=wisski
DB_PASSWORD=

# OpenGDB (triplestore)
PUBLIC_PORT=8080
DJANGO_SECRET_KEY=
DJANGO_SUPERUSER_NAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,authproxy,nginx
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
RDF4J_TIMEOUT=5
TS_REPOSITORY=default
TS_USERNAME=admin
TS_PASSWORD=
# Optional SPARQL token (see README: Django admin /api-token-auth/). Used only on first install.
TS_TOKEN=

# Drupal process budget (defaults match a small VPS). Raise for a larger host.
DRUPAL_CPUS=2.0
DRUPAL_MEMORY=2G
NGINX_WORKER_PROCESSES=2
PHP_FPM_MAX_CHILDREN=6

# SPARQL / IEF. Heap must stay below RDF4J_MEMORY (~1G extra for Tomcat).
RDF4J_CPUS=2.0
RDF4J_MEMORY=1536M
RDF4J_HEAP_MIN=256m
RDF4J_HEAP_MAX=1g

POSTGRES_CPUS=2.0
POSTGRES_MEMORY=2G
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_WORK_MEM=16MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB

# Solr / Redis / pgAdmin / Varnish
# Add ,solr to COMPOSE_PROFILES to start Solr on SOLR_PORT.
SOLR_PORT=8983
PGADMIN_PORT=8081
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
VARNISH_SIZE=256M
