{
	auto_https off
}

# Public port may not be 80 (e.g. HTTP_PORT=3600). Match on hostname only.
:80 {
	@site host {$SITE_HOST:wisski.localhost} localhost 127.0.0.1
	handle @site {
		request_body {
			max_size 512MB
		}
		reverse_proxy {$SITE_UPSTREAM:drupal:80} {
			transport http {
				dial_timeout 10s
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	@drupal host {$DRUPAL_HOST:drupal.wisski.localhost}
	handle @drupal {
		request_body {
			max_size 512MB
		}
		reverse_proxy drupal:80 {
			transport http {
				dial_timeout 10s
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	@gdb host {$GDB_HOST:gdb.wisski.localhost}
	handle @gdb {
		reverse_proxy nginx:80 {
			transport http {
				dial_timeout 10s
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	@pgadmin host {$PGADMIN_HOST:dbms.wisski.localhost}
	handle @pgadmin {
		reverse_proxy pgadmin:80
	}

	@solr host {$SOLR_HOST:search.wisski.localhost}
	handle @solr {
		reverse_proxy solr:8983
	}

	@importer host {$IMPORTER_HOST:import.wisski.localhost}
	handle @importer {
		request_body {
			max_size 512MB
		}
		reverse_proxy wisski-data-importer-web:8000 {
			transport http {
				dial_timeout 10s
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	handle {
		respond "Unknown host" 404
	}
}
